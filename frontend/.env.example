# Backend base URL (Express API in ../backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase web app config — Firebase console → Project settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Markham Civic Centre — fallback when the browser denies geolocation
NEXT_PUBLIC_DEFAULT_LAT=43.8561
NEXT_PUBLIC_DEFAULT_LNG=-79.3370
